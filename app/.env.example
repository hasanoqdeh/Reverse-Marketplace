# Reverse Marketplace — mobile app environment.
# Copy this file to `.env` and adjust per environment. `.env` is gitignored.
#
# API_URL is the backend origin (no trailing slash, no /api/v1 — that is appended
# automatically). If left unset, the app falls back to platform-aware localhost
# defaults (Android emulator: http://10.0.2.2:3000, iOS sim: http://localhost:3000).
#
# Examples:
#   Physical device on LAN:  API_URL=http://192.168.1.20:3000
#   Staging:                 API_URL=https://staging-api.example.com
#   Production:              API_URL=https://api.example.com

API_URL=
